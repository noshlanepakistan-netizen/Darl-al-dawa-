{
  "entities": {
    "HospitalConfig": {
      "title": "Hospital Configuration",
      "description": "Global hospital settings, public content, emergency contacts and operational parameters",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "tagline": { "type": "string" },
        "taglineUrdu": { "type": "string" },
        "emergencyNumber": { "type": "string" },
        "emergencyNumberRaw": { "type": "string" },
        "receptionPhone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "addressUrdu": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "emergencyNumber", "receptionPhone", "email", "address"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient appointment booking record",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "patientName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "cnic": { "type": "string", "maxLength": 20 },
        "departmentId": { "type": "string" },
        "doctorId": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "timeSlot": { "type": "string" },
        "patientType": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "no-show"] },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "phone", "departmentId", "appointmentDate", "status"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Hospital medical faculty and consultant specialists",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "departmentId": { "type": "string" },
        "specialty": { "type": "string" },
        "qualification": { "type": "string" },
        "experience": { "type": "string" },
        "opdTimings": { "type": "string" },
        "days": { "type": "string" },
        "feePKR": { "type": "number" },
        "image": { "type": "string" },
        "about": { "type": "string" },
        "pmdcNo": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "departmentId", "specialty", "feePKR", "pmdcNo"]
    },
    "Department": {
      "title": "Department",
      "description": "Medical and surgical clinical departments",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleUrdu": { "type": "string" },
        "iconName": { "type": "string" },
        "description": { "type": "string" },
        "descriptionUrdu": { "type": "string" },
        "headDoctor": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "iconName", "description"]
    },
    "Patient": {
      "title": "Patient Record",
      "description": "Basic hospital patient registry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "cnic": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "LabReport": {
      "title": "Lab Report",
      "description": "Diagnostic and pathology laboratory test report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "testName": { "type": "string" },
        "reportDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ready", "pending", "processing"] },
        "pdfUrl": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["reportId", "patientName", "patientPhone", "testName", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing statement for consultations and procedures",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "totalPKR": { "type": "number" },
        "discountPKR": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "patientName", "totalPKR", "paymentMethod", "status"]
    },
    "Message": {
      "title": "Contact Message",
      "description": "Inquiry message from patient or website visitor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "important": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "message"]
    },
    "StaffUser": {
      "title": "Staff User",
      "description": "Admin CMS authorized user account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "receptionist", "doctor", "lab_staff"] },
        "department": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "active"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Audit trail of CMS operations and changes",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userEmail", "action", "module", "timestamp"]
    }
  },
  "firestore": {
    "/hospital_config/{configId}": {
      "schema": "HospitalConfig",
      "description": "Hospital profile, contact info, and website settings"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Patient appointments booked online or manually"
    },
    "/doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Consultant doctors and specialists"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Clinical departments"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Hospital patients registry"
    },
    "/lab_reports/{reportId}": {
      "schema": "LabReport",
      "description": "Patient pathology and radiology lab reports"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Hospital billing records"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Public website contact inquiries"
    },
    "/users/{userId}": {
      "schema": "StaffUser",
      "description": "Admin staff user profiles with role-based access"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit logging of CMS changes"
    }
  }
}
