{
  "entities": {
    "Settings": {
      "title": "Hospital Settings",
      "description": "Global hospital settings, emergency numbers, contact channels, address, and operational hours",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "tagline": { "type": "string" },
        "taglineUrdu": { "type": "string" },
        "emergencyNumber": { "type": "string" },
        "emergencyNumberRaw": { "type": "string" },
        "receptionPhone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "addressUrdu": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "emergencyNumber", "receptionPhone", "email", "address"]
    },
    "HomepageContent": {
      "title": "Homepage Content",
      "description": "Hero banner slides, headlines, badges, and homepage section configuration",
      "type": "object",
      "properties": {
        "heroHeading": { "type": "string" },
        "heroSubheading": { "type": "string" },
        "heroButtonText": { "type": "string" },
        "aboutBadge": { "type": "string" },
        "aboutHeading": { "type": "string" },
        "aboutText": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["heroHeading", "heroButtonText"]
    },
    "HospitalConfig": {
      "title": "Hospital Configuration",
      "description": "Legacy hospital settings, emergency contacts and operational parameters",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "tagline": { "type": "string" },
        "emergencyNumber": { "type": "string" },
        "receptionPhone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "emergencyNumber", "receptionPhone", "email", "address"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Patient appointment booking record",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "patientName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "cnic": { "type": "string", "maxLength": 20 },
        "departmentId": { "type": "string" },
        "doctorId": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "timeSlot": { "type": "string" },
        "patientType": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled", "no-show"] },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "phone", "departmentId", "appointmentDate", "status"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Hospital medical faculty and consultant specialists",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "departmentId": { "type": "string" },
        "specialty": { "type": "string" },
        "qualification": { "type": "string" },
        "experience": { "type": "string" },
        "opdTimings": { "type": "string" },
        "days": { "type": "string" },
        "feePKR": { "type": "number" },
        "image": { "type": "string" },
        "about": { "type": "string" },
        "pmdcNo": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["name", "departmentId", "specialty", "feePKR", "pmdcNo"]
    },
    "Department": {
      "title": "Department",
      "description": "Medical and surgical clinical departments",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleUrdu": { "type": "string" },
        "iconName": { "type": "string" },
        "description": { "type": "string" },
        "descriptionUrdu": { "type": "string" },
        "headDoctor": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "iconName", "description"]
    },
    "Service": {
      "title": "Hospital Service",
      "description": "Clinical and diagnostic medical service",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleUrdu": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" }
      },
      "required": ["title", "description"]
    },
    "Package": {
      "title": "Health Package",
      "description": "Preventive healthcare and wellness package",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleUrdu": { "type": "string" },
        "pricePKR": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["title", "pricePKR"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Hospital facility or event photography",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "imageUrl"]
    },
    "Testimonial": {
      "title": "Patient Testimonial",
      "description": "Patient review and feedback",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "comment": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["patientName", "comment"]
    },
    "FAQ": {
      "title": "Frequently Asked Question",
      "description": "Healthcare FAQ for visitors",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["question", "answer"]
    },
    "Patient": {
      "title": "Patient Record",
      "description": "Hospital patient registry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "cnic": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "LabReport": {
      "title": "Lab Report",
      "description": "Diagnostic and pathology laboratory test report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "testName": { "type": "string" },
        "reportDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ready", "pending", "processing"] },
        "pdfUrl": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["reportId", "patientName", "patientPhone", "testName", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Billing statement for consultations and procedures",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "totalPKR": { "type": "number" },
        "discountPKR": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "createdAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "patientName", "totalPKR", "paymentMethod", "status"]
    },
    "Message": {
      "title": "Contact Message",
      "description": "Inquiry message from patient or website visitor",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "important": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "message"]
    },
    "StaffUser": {
      "title": "Staff User",
      "description": "Admin CMS authorized user account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "receptionist", "doctor", "lab_staff"] },
        "department": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "active"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "Audit logging of CMS changes",
      "type": "object",
      "properties": {
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userEmail", "action", "module", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or user real-time notification",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "role": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message", "role"]
    }
  },
  "firestore": {
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Primary hospital contact, emergency numbers, and operational configurations"
    },
    "/homepage/{homepageId}": {
      "schema": "HomepageContent",
      "description": "Homepage hero banner, promotional content, and section displays"
    },
    "/hospital_config/{configId}": {
      "schema": "HospitalConfig",
      "description": "Hospital profile, contact info, and website settings"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Patient appointments booked online or manually"
    },
    "/doctors/{doctorId}": {
      "schema": "Doctor",
      "description": "Consultant doctors and specialists"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Clinical departments"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Hospital diagnostic and clinical services"
    },
    "/packages/{packageId}": {
      "schema": "Package",
      "description": "Hospital checkup and executive packages"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Hospital facility gallery photos"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Patient reviews and testimonials"
    },
    "/faqs/{faqId}": {
      "schema": "FAQ",
      "description": "Frequently asked questions"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Hospital patients registry"
    },
    "/lab_reports/{reportId}": {
      "schema": "LabReport",
      "description": "Patient pathology and radiology lab reports"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Hospital billing records"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Public website contact inquiries"
    },
    "/users/{userId}": {
      "schema": "StaffUser",
      "description": "Admin staff user profiles with role-based access"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit logging of CMS changes"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "Real-time alerts for staff and patients"
    }
  }
}
