rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Central Hospital Configuration & Settings (Real-time sync across Netlify, mobile, desktop)
    match /hospital_config/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    // 2. Homepage Content & CMS
    match /homepage/{docId} {
      allow read, write: if true;
    }

    // 3. Departments
    match /departments/{departmentId} {
      allow read, write: if true;
    }

    // 4. Doctors
    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    // 5. Services & Facilities
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // 6. Health Packages
    match /packages/{packageId} {
      allow read, write: if true;
    }

    // 7. Gallery Items
    match /gallery/{itemId} {
      allow read, write: if true;
    }

    // 8. Patient Testimonials
    match /testimonials/{itemId} {
      allow read, write: if true;
    }

    // 9. Frequently Asked Questions
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // 10. Patient Appointments
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 11. Contact & Inquiry Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 12. Lab Reports
    match /lab_reports/{reportId} {
      allow read, write: if true;
    }

    // 13. Patient Profiles & Registrations
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // 14. Activity Logs & Diagnostic Self-Tests
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // 15. Live Push Notifications & Alerts
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
